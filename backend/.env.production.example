# Production Environment Variables Example

# Server Configuration
NODE_ENV=production
PORT=3001
API_URL=https://api.yourdomain.com

# Database (use managed database service)
DATABASE_URL=postgresql://user:password@db.host:5432/rambly?sslmode=require

# Redis (use managed Redis service)
REDIS_URL=redis://redis.host:6379

# Object Storage (AWS S3 or compatible)
S3_BUCKET=rambly-production-audio
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
S3_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# Google OAuth (production credentials)
GOOGLE_CLIENT_ID=your-production-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-production-client-secret
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_TO_DIFFERENT_STRONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d

# AI Provider Keys
TRANSCRIPTION_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-production-openai-api-key

# Guest Settings
GUEST_RAMBLE_EXPIRY_HOURS=24

# Security
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cookie Settings (production - secure)
COOKIE_DOMAIN=yourdomain.com
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# Logging
LOG_LEVEL=info
